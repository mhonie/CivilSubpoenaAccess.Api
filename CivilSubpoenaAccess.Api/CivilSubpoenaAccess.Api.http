Content-Type: application/json

{
  "query": "query ($approvedStartDate: DateTime!, $approvedEndDate: DateTime!, $filingStartDate: DateTime!, $filingEndDate: DateTime!, $first: Int!, $username: String!) { transactionsBySubpoenaStatus(approvedStartDate: $approvedStartDate approvedEndDate: $approvedEndDate filingStartDate: $filingStartDate filingEndDate: $filingEndDate) { approved(first: $first, where: { username: { startsWith: $username } }) { nodes { transactionId username filingDate approvedDate rejectedDate itemCount paymentAmount } pageInfo { hasNextPage endCursor } } } }",
  "variables": {
    "approvedStartDate": "2026-01-01T00:00:00Z",
    "approvedEndDate": "2026-07-06T23:59:59Z",
    "filingStartDate": "2026-01-01T00:00:00Z",
    "filingEndDate": "2026-07-06T23:59:59Z",
    "username": "shopper",
    "first": 5
  }
}

