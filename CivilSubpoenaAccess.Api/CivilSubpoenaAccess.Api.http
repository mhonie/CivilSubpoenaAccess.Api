@CivilSubpoenaAccess.Api_HostAddress = https://localhost:7146

### 
# Health Check
###
GET {{CivilSubpoenaAccess.Api_HostAddress}}/health

###
# Subpoena Status Counts
###
POST {{CivilSubpoenaAccess.Api_HostAddress}}/graphql
Content-Type: application/json

{
  "query": "query ($approvedStartDate: DateTime!, $approvedEndDate: DateTime!, $filingStartDate: DateTime!, $filingEndDate: DateTime!) { subpoenaStatusCounts(approvedStartDate: $approvedStartDate approvedEndDate: $approvedEndDate filingStartDate: $filingStartDate filingEndDate: $filingEndDate) { approved rejected pendingPayment pendingApproval error } }",
  "variables": {
    "approvedStartDate": "2026-01-01T00:00:00Z",
    "approvedEndDate": "2026-07-06T23:59:59Z",
    "filingStartDate": "2026-01-01T00:00:00Z",
    "filingEndDate": "2026-07-06T23:59:59Z"
  }
}

###
# Transactions By Subpoena Status
###
POST {{CivilSubpoenaAccess.Api_HostAddress}}/graphql
Content-Type: application/json

{
  "query": "query ($approvedStartDate: DateTime!, $approvedEndDate: DateTime!, $filingStartDate: DateTime!, $filingEndDate: DateTime!, $first: Int!) { transactionsBySubpoenaStatus(approvedStartDate: $approvedStartDate approvedEndDate: $approvedEndDate filingStartDate: $filingStartDate filingEndDate: $filingEndDate) { approved(first: $first) { nodes { transactionId username approvedDate itemCount paymentAmount } pageInfo { hasNextPage endCursor } } rejected(first: $first) { nodes { transactionId username rejectedDate itemCount paymentAmount } pageInfo { hasNextPage endCursor } } pendingApproval(first: $first) { nodes { transactionId username filingDate itemCount paymentAmount } pageInfo { hasNextPage endCursor } } pendingPayment(first: $first) { nodes { transactionId username filingDate itemCount paymentAmount } pageInfo { hasNextPage endCursor } } error } }",
  "variables": {
    "approvedStartDate": "2026-01-01T00:00:00Z",
    "approvedEndDate": "2026-07-06T23:59:59Z",
    "filingStartDate": "2026-01-01T00:00:00Z",
    "filingEndDate": "2026-07-06T23:59:59Z",
    "first": 5
  }
}

###
# Transactions By Subpoena Status - Filter Username
